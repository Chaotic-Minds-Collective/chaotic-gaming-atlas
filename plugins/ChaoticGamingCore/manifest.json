{
  "id": "com.chaoticminds.atlas.core",
  "name": "Chaotic Gaming Core",
  "version": "0.2.0",
  "game": "atlas",
  "apiVersion": "1",
  "dependencies": [],
  "capabilities": [
    "server.lifecycle",
    "server.heartbeat"
  ],
  "permissions": [
    "servers.heartbeat"
  ],
  "compatibility": {
    "gameBuilds": [],
    "serverApi": [
      "1.71"
    ],
    "operatingSystems": [
      "windows"
    ]
  },
  "configSchema": {
    "type": "object",
    "required": [
      "coreApiUrl",
      "serverId",
      "serviceToken"
    ],
    "properties": {
      "coreApiUrl": {
        "type": "string",
        "format": "uri"
      },
      "serverId": {
        "type": "string",
        "format": "uuid"
      },
      "serviceToken": {
        "type": "string",
        "minLength": 47
      },
      "serverBuild": {
        "type": "string"
      },
      "heartbeatIntervalSeconds": {
        "type": "integer",
        "minimum": 30,
        "maximum": 300
      }
    }
  }
}
