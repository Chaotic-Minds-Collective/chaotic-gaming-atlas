# Copy to .env and set values for the target dedicated server. Never commit .env.
NODE_ENV=development
CHAOTIC_CORE_API_URL=http://127.0.0.1:3001
CHAOTIC_CORE_SERVICE_TOKEN=replace-with-server-scoped-cg_srv-token
CHAOTIC_CORE_SERVER_ID=replace-with-registered-server-uuid
GAME_SERVER_HOST=127.0.0.1
GAME_QUERY_PORT=replace-with-atlas-query-port
ATLAS_SERVER_BUILD=unknown
HEARTBEAT_INTERVAL_SECONDS=60
