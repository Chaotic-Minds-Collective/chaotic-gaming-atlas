# Copy to .env and set values for the target dedicated server. Never commit .env.
NODE_ENV=development
CORE_API_URL=http://127.0.0.1:3001
CORE_API_SERVICE_TOKEN=replace-with-server-scoped-cg_srv-token
CORE_SERVER_ID=replace-with-registered-server-uuid
GAME_SERVER_HOST=127.0.0.1
GAME_QUERY_PORT=replace-with-atlas-query-port
GAME_SERVER_VERSION=unknown
HEARTBEAT_INTERVAL_MS=60000
